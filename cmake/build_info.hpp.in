#pragma once
// Generated at build time by cmake/GenBuildInfo.cmake. Lets every result file record exactly
// how the binary was built.
namespace lle::build_info {
inline constexpr const char* git_sha    = "@LLE_GIT_SHA@";
inline constexpr bool        git_dirty  = @LLE_GIT_DIRTY@;  // uncommitted changes at build time
inline constexpr const char* build_type = "@CMAKE_BUILD_TYPE@";
inline constexpr const char* compiler   = "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@";
inline constexpr const char* cxx_flags  = "@LLE_BUILD_FLAGS@";
inline constexpr const char* sanitizer  = "@LLE_SANITIZER@";
}  // namespace lle::build_info
